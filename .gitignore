*~

# Credentials never enter the repository: the job authenticates only through Application
# Default Credentials that its environment provides when it runs, as AGENTS.md records. These
# are the usual names of the files that hold them, and of the directories they are kept in.
application_default_credentials.json
*credentials*.json
*service-account*.json
*service_account*.json
*-key.json
*_key.json
key.json
keyfile.json
*.p12
*.pem
.gcloud/
gcloud/
secrets/

# The IMDb datasets are licensed for personal and non-commercial use only: the job downloads
# them where it runs and never commits them, wherever they land.
*.tsv
*.tsv.gz
